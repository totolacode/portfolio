---
interface Props {
  /** "slideshow": Top's dual-image pan + torn noise edge. "static": About's single photo filling the space left of the panel. */
  mode: "slideshow" | "static";
}

const { mode } = Astro.props;
---

<div class:list={["bg-photo", mode]} id="bgPhoto" aria-hidden="true">
  {
    mode === "slideshow" ? (
      <>
        <img class="bg-photo-img" id="bgImgA" alt="" />
        <img class="bg-photo-img" id="bgImgB" alt="" />
      </>
    ) : (
      <picture>
        <source media="(min-width: 861px)" srcset="/photos/about/about.webp" />
        <img
          class="bg-photo-img"
          id="bgImg"
          alt=""
          src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        />
      </picture>
    )
  }
</div>

<style>
  .bg-photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  /* Top: torn noise-mask edge, right side only */
  .bg-photo.slideshow {
    -webkit-mask-image: url("/noise-mask.svg");
    mask-image: url("/noise-mask.svg");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* About: fills the space to the left of the panel (see AboutPanel .file-panel
     width / margin-right) and tucks ~80px behind it. It fades out towards the
     panel, and the panel's own blur takes over from there. */
  .bg-photo.static {
    inset: 0 auto 0 0;
    width: calc(100% - min(92vw, 640px) - clamp(20px, 5vw, 64px) + 80px);
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 60%, transparent 100%);
    mask-image: linear-gradient(to right, #000 0%, #000 60%, transparent 100%);
  }

  .bg-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .bg-photo-img.active {
    opacity: 1;
  }

  .slideshow .bg-photo-img {
    transform: scale(1.15);
    transition: opacity 1.4s ease;
    filter: saturate(0.55) brightness(0.6) contrast(1.05);
  }
  .static .bg-photo-img {
    object-position: 50% 55%;
    filter: saturate(0.75) brightness(0.72) contrast(1.05);
  }

  .slideshow .bg-photo-img.pan-down {
    animation: panDown 10s ease-in-out forwards;
  }
  .slideshow .bg-photo-img.pan-up {
    animation: panUp 10s ease-in-out forwards;
  }
  .slideshow .bg-photo-img.pan-right {
    animation: panRight 10s ease-in-out forwards;
  }
  .slideshow .bg-photo-img.pan-left {
    animation: panLeft 10s ease-in-out forwards;
  }
  @keyframes panDown {
    from {
      transform: scale(1.15) translateY(-3%);
    }
    to {
      transform: scale(1.15) translateY(3%);
    }
  }
  @keyframes panUp {
    from {
      transform: scale(1.15) translateY(3%);
    }
    to {
      transform: scale(1.15) translateY(-3%);
    }
  }
  @keyframes panRight {
    from {
      transform: scale(1.15) translateX(-3%);
    }
    to {
      transform: scale(1.15) translateX(3%);
    }
  }
  @keyframes panLeft {
    from {
      transform: scale(1.15) translateX(3%);
    }
    to {
      transform: scale(1.15) translateX(-3%);
    }
  }

  @media (max-width: 860px) {
    .bg-photo.static {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .bg-photo.slideshow {
      display: none;
    }
  }
</style>

<script>
  const TOP_PHOTOS = Array.from({ length: 14 }, (_, i) => `/photos/top/${String(i + 1).padStart(2, "0")}.webp`);

  // shuffled queue so every photo shows once per round, never the same one twice in a row
  let queue: string[] = [];
  let lastPhoto = "";
  function nextPhotoUrl(): string {
    if (queue.length === 0) {
      queue = [...TOP_PHOTOS];
      for (let i = queue.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [queue[i], queue[j]] = [queue[j]!, queue[i]!];
      }
      if (queue[queue.length - 1] === lastPhoto) queue.unshift(queue.pop()!);
    }
    lastPhoto = queue.pop()!;
    return lastPhoto;
  }

  const bgPhotoEl = document.getElementById("bgPhoto");
  if (bgPhotoEl) {
    const container: HTMLElement = bgPhotoEl;
    const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

    if (container.classList.contains("slideshow")) {
      const imgs = [document.getElementById("bgImgA"), document.getElementById("bgImgB")].filter(
        (el): el is HTMLImageElement => el instanceof HTMLImageElement
      );
      let activeIdx = 0;
      const panDirections = ["pan-down", "pan-right", "pan-up", "pan-left"];
      let panIndex = 0;

      function applyPan(imgEl: HTMLImageElement): void {
        imgEl.classList.remove("pan-down", "pan-up", "pan-left", "pan-right");
        if (reduced) return;
        void imgEl.offsetWidth; // restart the animation on this reused element
        imgEl.classList.add(panDirections[panIndex % panDirections.length]!);
        panIndex++;
      }

      function showNextPhoto(retriesLeft = 3): void {
        if (getComputedStyle(container).display === "none") return;
        const nextIdx = 1 - activeIdx;
        const img = new Image();
        img.onload = () => {
          const target = imgs[nextIdx]!;
          target.src = img.src;
          applyPan(target);
          target.classList.add("active");
          imgs[activeIdx]!.classList.remove("active");
          activeIdx = nextIdx;
        };
        img.onerror = () => {
          if (retriesLeft > 0) setTimeout(() => showNextPhoto(retriesLeft - 1), 1200);
        };
        img.src = nextPhotoUrl();
      }

      showNextPhoto();
      if (!reduced) setInterval(() => showNextPhoto(), 9000);
    } else {
      const bgImgEl = document.getElementById("bgImg");
      if (bgImgEl instanceof HTMLImageElement) {
        const img: HTMLImageElement = bgImgEl;
        const reveal = () => {
          if (img.currentSrc.endsWith("about.webp")) img.classList.add("active");
        };
        reveal();
        img.addEventListener("load", reveal);
      }
    }
  }
</script>
