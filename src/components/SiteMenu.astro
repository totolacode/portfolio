---
export type CurrentPage = "top" | "about" | "works";

interface Props {
  current: CurrentPage;
}

const { current } = Astro.props;

const items: { key: CurrentPage; label: string; href: string }[] = [
  { key: "top", label: "Top", href: "/" },
  { key: "about", label: "About", href: "/about" },
  { key: "works", label: "Works", href: "/works" },
];
---

<button
  type="button"
  class="menu-toggle"
  id="menuToggle"
  aria-expanded="false"
  aria-controls="siteMenu"
  aria-label="メニュー"
>
  <span class="menu-toggle-bar"></span>
  <span class="menu-toggle-bar"></span>
  <span class="menu-toggle-bar"></span>
</button>

<div class="site-menu" id="siteMenu" aria-hidden="true">
  <nav class="site-menu-list" aria-label="サイトメニュー">
    {
      items.map((item) => (
        <a
          class={`site-menu-item ${item.key === current ? "current" : ""}`}
          href={item.href}
          aria-current={item.key === current ? "page" : undefined}
        >
          <span>{item.label}</span>
        </a>
      ))
    }
    <a class="site-menu-item" href="/contact">
      <span>Contact</span>
    </a>
  </nav>
</div>

<style>
  .menu-toggle {
    position: fixed;
    top: clamp(20px, 4vw, 32px);
    right: clamp(20px, 4vw, 32px);
    z-index: 60;
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    appearance: none;
  }
  .menu-toggle-bar {
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease,
      background 0.2s ease;
  }
  .menu-toggle:hover .menu-toggle-bar {
    background: var(--accent-solid);
  }
  .menu-toggle.open .menu-toggle-bar:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .menu-toggle.open .menu-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.open .menu-toggle-bar:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 8, 11, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .site-menu.open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease,
      visibility 0s linear;
  }

  .site-menu-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(4px, 1vw, 8px);
  }

  .site-menu-item {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--muted);
    font-family: var(--mono);
    font-size: clamp(24px, 4.4vw, 36px);
    letter-spacing: 0.03em;
    padding: 10px 34px 10px 6px;
    transition: color 0.2s ease;
  }
  .site-menu-item::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -10px;
    right: -14px;
    background: linear-gradient(90deg, rgba(233, 236, 242, 0.16), rgba(233, 236, 242, 0.03) 85%);
    -webkit-mask-image: url("/band-mask.svg");
    mask-image: url("/band-mask.svg");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    opacity: 0;
    transform: scaleX(0.7);
    transform-origin: left center;
    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
    z-index: -1;
  }
  .site-menu-item:hover,
  .site-menu-item:focus-visible,
  .site-menu-item.current {
    color: var(--ink);
    outline: none;
  }
  .site-menu-item:hover::before,
  .site-menu-item:focus-visible::before,
  .site-menu-item.current::before {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle-bar,
    .site-menu {
      transition: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menuToggle");
  const menu = document.getElementById("siteMenu");

  function closeMenu(): void {
    toggle?.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
    menu?.classList.remove("open");
    menu?.setAttribute("aria-hidden", "true");
  }
  function openMenu(): void {
    toggle?.classList.add("open");
    toggle?.setAttribute("aria-expanded", "true");
    menu?.classList.add("open");
    menu?.setAttribute("aria-hidden", "false");
  }

  toggle?.addEventListener("click", () => {
    if (menu?.classList.contains("open")) closeMenu();
    else openMenu();
  });
  menu?.addEventListener("click", (e) => {
    if (e.target === menu) closeMenu();
  });
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
